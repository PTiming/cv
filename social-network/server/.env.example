# Server Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database - MongoDB Atlas (or local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# For local: mongodb://localhost:27017/social_network
MONGODB_URI=mongodb://localhost:27017/social_network

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Cloudinary Configuration (for image/file uploads)
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Moodle LMS Configuration
# Your Moodle instance URL (e.g., https://yourschool.moodlecloud.com)
MOODLE_URL=https://your-moodle-instance.moodlecloud.com
MOODLE_CLIENT_ID=your-oauth-client-id
MOODLE_CLIENT_SECRET=your-oauth-client-secret
MOODLE_REDIRECT_URI=http://localhost:5000/api/auth/moodle/callback
MOODLE_TOKEN=your_moodle_webservice_token
MOODLE_SERVICE=moodle_mobile_app

# Moodle API Endpoints (usually don't need to change)
MOODLE_TOKEN_ENDPOINT=/login/token.php
MOODLE_API_ENDPOINT=/webservice/rest/server.php

# File Upload Configuration
MAX_FILE_SIZE=10
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=your_session_secret_key_here
SESSION_EXPIRE=86400000

# Logging
LOG_LEVEL=info
